#!/bin/sh

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  export COCOAPODS_PODX_COLOR="${COCOAPODS_PODX_COLOR:-1}"
fi

print_progress_log_chunk() {
  progress_file="$1"
  progress_skip="$2"
  progress_count="$3"
  dd if="$progress_file" bs=1 skip="$progress_skip" count="$progress_count" 2>/dev/null |
    sed '/^Ignoring ffi-[^ ]* because its extensions are not built\. Try: gem pristine ffi --version [^ ]*$/d'
}

run_with_wait_progress() {
  progress_label="$1"
  shift

  if [ ! -t 1 ] || [ -n "${COCOAPODS_PODX_NO_PROGRESS:-}" ]; then
    "$@"
    return $?
  fi

  progress_log="$(mktemp "${TMPDIR:-/tmp}/cocoapods-podx-progress.XXXXXX")"
  : >"$progress_log"
  "$@" >"$progress_log" 2>&1 &
  progress_pid=$!
  progress_offset=0
  progress_ticks=0
  progress_frame=0
  progress_shown=0
  progress_first_output_seen=0

  while kill -0 "$progress_pid" 2>/dev/null; do
    progress_size="$(wc -c <"$progress_log" 2>/dev/null | tr -d ' ')"
    progress_size="${progress_size:-0}"
    if [ "$progress_size" -gt "$progress_offset" ]; then
      progress_first_output_seen=1
      if [ "$progress_shown" -eq 1 ]; then
        printf '\r\033[2K'
        progress_shown=0
      fi
      print_progress_log_chunk "$progress_log" "$progress_offset" "$((progress_size - progress_offset))"
      progress_offset="$progress_size"
    elif [ "$progress_first_output_seen" -eq 0 ] && [ "$progress_ticks" -ge 5 ]; then
      case "$progress_frame" in
        0) progress_dots="." ;;
        1) progress_dots=".." ;;
        *) progress_dots="..." ;;
      esac
      printf '\r\033[2K%s 执行中%s' "$progress_label" "$progress_dots"
      progress_shown=1
      progress_frame=$(((progress_frame + 1) % 3))
    fi
    progress_ticks=$((progress_ticks + 1))
    sleep 0.1
  done

  wait "$progress_pid"
  progress_status=$?
  progress_size="$(wc -c <"$progress_log" 2>/dev/null | tr -d ' ')"
  progress_size="${progress_size:-0}"
  if [ "$progress_shown" -eq 1 ]; then
    printf '\r\033[2K'
  fi
  if [ "$progress_size" -gt "$progress_offset" ]; then
    print_progress_log_chunk "$progress_log" "$progress_offset" "$((progress_size - progress_offset))"
  fi
  rm -f "$progress_log"
  return "$progress_status"
}

run_capture_with_wait_progress() {
  progress_label="$1"
  progress_log="$2"
  shift 2

  if [ ! -t 1 ] || [ -n "${COCOAPODS_PODX_NO_PROGRESS:-}" ]; then
    "$@" >"$progress_log" 2>&1
    return $?
  fi

  "$@" >"$progress_log" 2>&1 &
  progress_pid=$!
  progress_ticks=0
  progress_frame=0
  progress_shown=0

  while kill -0 "$progress_pid" 2>/dev/null; do
    if [ "$progress_ticks" -ge 5 ]; then
      case "$progress_frame" in
        0) progress_dots="." ;;
        1) progress_dots=".." ;;
        *) progress_dots="..." ;;
      esac
      printf '\r\033[2K%s 执行中%s' "$progress_label" "$progress_dots"
      progress_shown=1
      progress_frame=$(((progress_frame + 1) % 3))
    fi
    progress_ticks=$((progress_ticks + 1))
    sleep 0.1
  done

  wait "$progress_pid"
  progress_status=$?
  if [ "$progress_shown" -eq 1 ]; then
    printf '\r\033[2K'
  fi
  return "$progress_status"
}

detect_cocoapods_gem_home() {
  pod_path="$(command -v pod 2>/dev/null)"
  if [ -n "$pod_path" ] && [ -f "$pod_path" ]; then
    parsed="$(sed -n 's/^GEM_HOME="\([^"]*\)".*/\1/p' "$pod_path" 2>/dev/null | head -n 1)"
    if [ -n "$parsed" ]; then
      echo "$parsed"
      return 0
    fi
  fi

  ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods").max_by(&:version); puts spec ? spec.base_dir : ""' 2>/dev/null
}

detect_cocoapods_ruby() {
  command -v ruby
}

podx_spec_value() {
  query="$1"
  local_gem_home="${gem_home:-$(detect_cocoapods_gem_home)}"
  PODX_SPEC_QUERY="$query" PODX_GEM_HOME="$local_gem_home" ruby -e '
require "rubygems"

entries = []
Gem::Specification.find_all_by_name("cocoapods-podx").each do |spec|
  entries << [spec.version.to_s, spec.full_gem_path]
end

gem_home = ENV["PODX_GEM_HOME"].to_s
unless gem_home.empty?
  begin
    Gem::Specification.dirs = [gem_home]
    Gem::Specification.reset
    Gem::Specification.find_all_by_name("cocoapods-podx").each do |spec|
      entries << [spec.version.to_s, spec.full_gem_path]
    end
  rescue
  end
end

entry = entries.uniq.max_by { |version, _path| Gem::Version.new(version) }
exit 0 unless entry

if ENV["PODX_SPEC_QUERY"] == "lib"
  puts File.join(entry[1], "lib")
else
  puts entry[0]
end
' 2>/dev/null
}

detect_podx_lib_path() {
  if [ -n "$COCOAPODS_PODX_LOCAL_LIB" ] && [ -d "$COCOAPODS_PODX_LOCAL_LIB" ]; then
    echo "$COCOAPODS_PODX_LOCAL_LIB"
    return 0
  fi

  podx_lib="$(podx_spec_value lib)"
  if [ -n "$podx_lib" ]; then
    echo "$podx_lib"
  fi
}

pod_available() {
  command -v pod >/dev/null 2>&1
}

latest_podx_version_from_nexus() {
  if [ -n "$COCOAPODS_PODX_LATEST_VERSION" ]; then
    echo "$COCOAPODS_PODX_LATEST_VERSION"
    return 0
  fi

  NEXUS_SEARCH_API="${COCOAPODS_PODX_NEXUS_SEARCH_API:-${COCOAPODS_OVERLAY_NEXUS_SEARCH_API:-http://172.31.4.4:9091/service/rest/beta/search/assets?repository=nn_ios}}" \
  NEXUS_USER="${COCOAPODS_PODX_NEXUS_USER:-${COCOAPODS_OVERLAY_NEXUS_USER:-admin}}" \
  NEXUS_PASSWORD="${COCOAPODS_PODX_NEXUS_PASSWORD:-${COCOAPODS_OVERLAY_NEXUS_PASSWORD:-admin123}}" \
  ruby -e '
require "json"
require "net/http"
require "uri"

api = ENV.fetch("NEXUS_SEARCH_API")
user = ENV["NEXUS_USER"]
password = ENV["NEXUS_PASSWORD"]
versions = []
token = nil

loop do
  uri = URI(api)
  params = URI.decode_www_form(uri.query || "")
  params << ["continuationToken", token] if token && !token.empty?
  uri.query = URI.encode_www_form(params)
  request = Net::HTTP::Get.new(uri)
  request.basic_auth(user, password) if user && !user.empty?
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https") { |http| http.request(request) }
  abort("Nexus 查询失败：HTTP #{response.code}") unless response.is_a?(Net::HTTPSuccess)
  body = JSON.parse(response.body)
  Array(body["items"]).each do |item|
    path = item["path"].to_s
    next unless path.start_with?("rubygems/cocoapods-podx/")
    match = path.match(%r{cocoapods-podx-([0-9]+(?:\.[0-9]+)*)\.gem\z})
    versions << match[1] if match
  end
  token = body["continuationToken"]
  break if token.nil? || token.empty?
end

abort("Nexus 中未找到 cocoapods-podx gem。") if versions.empty?
puts versions.max_by { |version| version.split(".").map(&:to_i) }
'
}

upgrade_cocoapods_podx() {
  current_version="$1"
  target_version="$2"
  COCOAPODS_PODX_UPGRADED=0
  gem_home="$(detect_cocoapods_gem_home)"
  if [ -z "$gem_home" ]; then
    gem_home="$(ruby -e 'require "rubygems"; puts Gem.user_dir')"
  fi

  if [ -z "$target_version" ]; then
    echo "cocoapods-podx [check] 正在查询远端最新版本..."
    target_version="$(latest_podx_version_from_nexus)"
  fi

  case "$target_version" in
    ""|*[!0-9.]*|.*|*..*|*.)
      echo "cocoapods-podx [upgrade] 版本号不合法：$target_version" >&2
      return 1
      ;;
  esac

  if [ -n "$target_version" ] && [ "$target_version" = "$current_version" ]; then
    echo "cocoapods-podx $current_version 已是最新版本，无需更新"
    return 0
  fi

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/cocoapods-podx-upgrade.XXXXXX")"
  gem_file="$tmp_dir/cocoapods-podx-$target_version.gem"
  gem_url="${COCOAPODS_PODX_GEM_SOURCE:-${COCOAPODS_OVERLAY_GEM_SOURCE:-http://172.31.4.4:9091/repository/nn_ios/rubygems/cocoapods-podx/}}"
  gem_url="${gem_url%/}/cocoapods-podx-$target_version.gem"
  nexus_user="${COCOAPODS_PODX_NEXUS_USER:-${COCOAPODS_OVERLAY_NEXUS_USER:-admin}}"
  nexus_password="${COCOAPODS_PODX_NEXUS_PASSWORD:-${COCOAPODS_OVERLAY_NEXUS_PASSWORD:-admin123}}"

  echo "cocoapods-podx [upgrade] $current_version -> $target_version"
  if [ -n "$nexus_user" ]; then
    curl -fL -u "$nexus_user:$nexus_password" -o "$gem_file" "$gem_url" || {
      rm -rf "$tmp_dir"
      return 1
    }
  else
    curl -fL -o "$gem_file" "$gem_url" || {
      rm -rf "$tmp_dir"
      return 1
    }
  fi

  GEM_HOME="$gem_home" \
  GEM_PATH="$gem_home" \
  gem install --local --ignore-dependencies --force --no-document "$gem_file"

  installed_dir="$(GEM_HOME="$gem_home" GEM_PATH="$gem_home" ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts spec.full_gem_path')"
  command_dir="${COCOAPODS_PODX_COMMAND_DIR:-$(dirname "$0")}"
  if [ -w "$command_dir" ]; then
    install_upgrade_shim "$installed_dir/bin/podx" "$command_dir/podx"
    install_upgrade_shim "$installed_dir/bin/mgit" "$command_dir/mgit"
  else
    echo "Warning: 无法刷新命令 shim：$command_dir 不可写" >&2
  fi

  rm -rf "$tmp_dir"
  COCOAPODS_PODX_UPGRADED=1
  echo "cocoapods-podx [upgraded] $target_version"
}

exec_upgrade_from_temp_shim() {
  current_version="$1"
  target_version="$2"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/cocoapods-podx-self-upgrade.XXXXXX")"
  tmp_shim="$tmp_dir/podx"
  cp "$0" "$tmp_shim"
  chmod +x "$tmp_shim"
  COCOAPODS_PODX_COMMAND_DIR="$(dirname "$0")" \
  COCOAPODS_PODX_SELF_UPGRADE_DIR="$tmp_dir" \
  exec "$tmp_shim" __upgrade "$current_version" "$target_version"
}

install_upgrade_shim() {
  source_path="$1"
  target_path="$2"
  tmp_path="${target_path}.tmp.$$"
  running_path="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0")"
  target_real_path="$(cd "$(dirname "$target_path")" 2>/dev/null && pwd -P)/$(basename "$target_path")"
  cp "$source_path" "$tmp_path"
  chmod +x "$tmp_path"
  if [ "$target_real_path" = "$running_path" ]; then
    echo "Warning: 跳过正在执行的 shim 刷新：$target_path" >&2
    rm -f "$tmp_path"
    return 0
  fi
  mv -f "$tmp_path" "$target_path"
}

current_podx_version() {
  version="$(podx_spec_value version)"
  if [ -n "$version" ]; then
    echo "$version"
  fi
}

detect_podx_lib_and_gem_env() {
  gem_home=""
  podx_lib="$(detect_podx_lib_path)"
  if [ -z "$podx_lib" ]; then
    gem_home="$(detect_cocoapods_gem_home)"
    podx_lib="$(detect_podx_lib_path)"
  fi
  if [ -n "$podx_lib" ]; then
    export RUBYLIB="$podx_lib${RUBYLIB:+:$RUBYLIB}"
  fi
  if [ -n "$gem_home" ]; then
    export GEM_HOME="$gem_home"
  fi
  load_podx_git_token_from_keychain
}

podx_git_token_service() {
  echo "${COCOAPODS_PODX_GIT_TOKEN_SERVICE:-cocoapods-podx-git-token}"
}

load_podx_git_token_from_keychain() {
  [ -z "${COCOAPODS_PODX_GIT_TOKEN:-}" ] || return 0
  command -v security >/dev/null 2>&1 || return 0

  token="$(security find-generic-password -a "${USER:-$LOGNAME}" -s "$(podx_git_token_service)" -w 2>/dev/null || true)"
  [ -z "$token" ] || export COCOAPODS_PODX_GIT_TOKEN="$token"
}

podx_gitlab_url() {
  if [ -n "${COCOAPODS_PODX_GITLAB_URL:-}" ]; then
    echo "$COCOAPODS_PODX_GITLAB_URL"
    return 0
  fi

  config_path="podx.config.yml"
  if [ -f "$config_path" ]; then
    parsed="$(ruby -ryaml -e 'config = YAML.load_file(ARGV[0]) || {}; puts config["git_base_url"].to_s' "$config_path" 2>/dev/null || true)"
    if [ -n "$parsed" ]; then
      echo "$parsed"
      return 0
    fi
  fi

  echo "http://git.leigod.top"
}

print_podx_git_token_setup_guide() {
  gitlab_url="$(podx_gitlab_url)"
  cat <<GUIDE
设置token:
1、请访问 ${gitlab_url%/}/profile/personal_access_tokens
2、若没有Access Token，先创建Access Token，Scopes 只勾选 api
3、获取git平台的Access Token，使用 podx git-token set 命令设置
GUIDE
}

podx_git_token_validate() {
  token="$1"
  gitlab_url="$(podx_gitlab_url)"
  PODX_GIT_TOKEN_TO_VALIDATE="$token" PODX_GITLAB_URL="$gitlab_url" ruby <<'RUBY'
require "net/http"
require "uri"

begin
token = ENV.fetch("PODX_GIT_TOKEN_TO_VALIDATE").to_s
base_url = ENV.fetch("PODX_GITLAB_URL").to_s.sub(%r{/+\z}, "")
uri = URI("#{base_url}/api/v4/user")
request = Net::HTTP::Get.new(uri)
request["PRIVATE-TOKEN"] = token
response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 5, read_timeout: 10) do |http|
  http.request(request)
end

case response.code.to_i
when 200
  exit 0
when 401
  warn "GitLab Token 无效或已过期，请重新执行：podx git-token set YOUR_GITLAB_TOKEN"
  exit 2
when 403
  warn "GitLab Token 权限不足，请确认 token 勾选 api。"
  exit 3
else
  warn "GitLab Token 校验失败：HTTP #{response.code}"
  exit 4
end
rescue => e
  warn "GitLab Token 校验失败：#{e.class}: #{e.message}"
  exit 4
end
RUBY
}

podx_git_token_command() {
  command="$1"
  shift || true
  [ -n "$command" ] || command="status"

  case "$command" in
    status)
      source=""
      if [ -n "${COCOAPODS_PODX_GIT_TOKEN:-}" ]; then
        token="$COCOAPODS_PODX_GIT_TOKEN"
        source="env"
      elif command -v security >/dev/null 2>&1; then
        token="$(security find-generic-password -a "${USER:-$LOGNAME}" -s "$(podx_git_token_service)" -w 2>/dev/null || true)"
        [ -z "$token" ] || source="keychain"
      fi
      if [ -n "$token" ]; then
        podx_git_token_validate "$token"
        validation_status=$?
        if [ "$validation_status" -eq 0 ]; then
          echo "COCOAPODS_PODX_GIT_TOKEN [$source] 有效"
          return 0
        fi
        return "$validation_status"
      fi
      echo "COCOAPODS_PODX_GIT_TOKEN [missing] 未配置"
      print_podx_git_token_setup_guide
      return 1
      ;;
    set)
      token="$1"
      if [ -z "$token" ]; then
        if [ ! -t 0 ]; then
          echo "[!] 缺少 GitLab Token：podx git-token set YOUR_GITLAB_TOKEN" >&2
          return 1
        fi
        printf "请输入 GitLab Token: "
        stty -echo 2>/dev/null || true
        IFS= read -r token
        stty echo 2>/dev/null || true
        printf "\n"
      fi
      if [ -z "$token" ]; then
        echo "[!] GitLab Token 不能为空" >&2
        return 1
      fi
      command -v security >/dev/null 2>&1 || {
        echo "[!] 当前系统不支持 macOS Keychain security 命令" >&2
        return 1
      }
      security add-generic-password -a "${USER:-$LOGNAME}" -s "$(podx_git_token_service)" -w "$token" -U >/dev/null
      echo "COCOAPODS_PODX_GIT_TOKEN [keychain] 已保存"
      ;;
    clear|delete|remove)
      if command -v security >/dev/null 2>&1 &&
         security delete-generic-password -a "${USER:-$LOGNAME}" -s "$(podx_git_token_service)" >/dev/null 2>&1; then
        echo "COCOAPODS_PODX_GIT_TOKEN [keychain] 已清除"
      else
        echo "COCOAPODS_PODX_GIT_TOKEN [keychain] 未找到"
      fi
      ;;
    help|--help|-h)
      cat <<'HELP'
podx git-token 用于配置 GitLab API Token，供 mgit publish 远端创建组件分支使用。

用法:
  podx git-token status
  podx git-token set YOUR_GITLAB_TOKEN
  podx git-token set
  podx git-token clear

说明:
  Token 保存到 macOS Keychain，不写入工程文件或 Git。
  podx/mgit 执行时会自动读取 Keychain 并注入 COCOAPODS_PODX_GIT_TOKEN。
HELP
      ;;
    *)
      echo "[!] 未知 git-token 命令：$command" >&2
      echo "用法：podx git-token status|set|clear" >&2
      return 1
      ;;
  esac
}

run_publish_only() {
  detect_podx_lib_and_gem_env
  run_with_wait_progress "podx" ruby -rcocoapods_podx/publish_only -e 'CocoapodsPodx::PublishOnly.run(ARGV)' -- "$@"
  exit $?
}

run_pod_overlay() {
  detect_podx_lib_and_gem_env
  COCOAPODS_PODX_INTERNAL=1 run_with_wait_progress "podx" ruby -e '
value_options = %w[
  --branch
  --publish-branch
  --job
  --jenkins-job
  --jenkins-url
  --publish-password
  --notify-wechat
  --force-private-pod-update
  --fix-job
  --lines
  --limit
]
normalized = []
args = ARGV.dup
until args.empty?
  arg = args.shift
  if arg == "--no-wechat-notify"
    normalized << "--notify-wechat=false"
  elsif arg == "--no-force-private-pod-update"
    normalized << "--force-private-pod-update=false"
  elsif arg == "--force-private-pod-update" && (args.empty? || args.first.start_with?("-"))
    normalized << "--force-private-pod-update=true"
  elsif value_options.include?(arg) && !args.empty? && !args.first.start_with?("-")
    normalized << "#{arg}=#{args.shift}"
  else
    normalized << arg
  end
end
exec("pod", "podx", *normalized)
' -- "$@"
  exit $?
}

args_include_repo_update() {
  for arg in "$@"; do
    case "$arg" in
      --repo-update|--repo-update=*)
        return 0
        ;;
    esac
  done
  return 1
}

extract_pod_install_error_name() {
  log_file="$1"
  sed -n "s/.*Error installing \\([^[:space:]]*\\).*/\\1/p" "$log_file" 2>/dev/null | head -n 1
}

snapshot_pbxproj_files() {
  snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/podx-pbxproj.XXXXXX")"
  list_file="$snapshot_dir/files"
  : >"$list_file"

  find . -maxdepth 2 -path "*.xcodeproj/project.pbxproj" -type f 2>/dev/null | while IFS= read -r file; do
    key="$(printf "%s" "$file" | sed 's#[^A-Za-z0-9_.-]#_#g')"
    backup="$snapshot_dir/$key"
    cp "$file" "$backup"
    printf "%s\t%s\n" "$file" "$backup" >>"$list_file"
  done

  echo "$snapshot_dir"
}

pbxproj_diff_is_noop() {
  ruby - "$1" "$2" <<'RUBY'
before_path, after_path = ARGV

def normalize_pbxproj_noop_changes(path)
  lines = File.read(path).lines
  result = []
  index = 0

  while index < lines.length
    line = lines[index]
    next_line = lines[index + 1]
    if line.match?(/^\s*(exceptions|inputPaths|outputPaths) = \(\s*$/) &&
       next_line &&
       next_line.match?(/^\s*\);\s*$/)
      index += 2
      next
    end

    result << line
    index += 1
  end

  result.join
end

exit(normalize_pbxproj_noop_changes(before_path) == normalize_pbxproj_noop_changes(after_path) ? 0 : 1)
RUBY
}

restore_noop_pbxproj_changes() {
  snapshot_dir="$1"
  list_file="$snapshot_dir/files"
  [ -f "$list_file" ] || return 0

  while IFS="$(printf '\t')" read -r file backup; do
    [ -f "$file" ] && [ -f "$backup" ] || continue
    cmp -s "$file" "$backup" && continue

    if pbxproj_diff_is_noop "$backup" "$file"; then
      cp "$backup" "$file"
    fi
  done <"$list_file"
}

print_pod_install_success_log() {
  log_file="$1"
  if [ "${COCOAPODS_PODX_INSTALL_VERBOSE:-0}" = "1" ]; then
    cat "$log_file"
    return 0
  fi

  sed -n '/^【podx install】/p;/^[+|]/p' "$log_file"
}

run_raw_pod_install_capture() {
  log_file="$1"
  shift
  run_capture_with_wait_progress "podx install" "$log_file" pod install "$@"
}

overlay_pod_names() {
  [ -f "Podfile.overlay" ] || return 0

  ruby <<'RUBY' 2>/dev/null
def pod_names_from(path)
  return [] unless File.exist?(path)

  File.readlines(path).each_with_object([]) do |line, names|
    next if line.strip.start_with?("#")

    match = line.match(/^\s*pod\s+["']([^"']+)["']/)
    names << match[1] if match
  end
end

def group_name_from_pod_line(line)
  line[/[:]?group_name\s*=>\s*["']([^"']+)["']/, 1] ||
    line[/group_name:\s*["']([^"']+)["']/, 1]
end

overlay_names = pod_names_from("Podfile.overlay")
names = overlay_names.dup

if File.exist?("Podfile")
  File.readlines("Podfile").each do |line|
    next if line.strip.start_with?("#")

    match = line.match(/^\s*pod\s+["']([^"']+)["'](.*)$/)
    next unless match

    pod_name = match[1]
    options_text = match[2].to_s
    group_name = group_name_from_pod_line(options_text)
    next unless overlay_names.include?(pod_name) || (group_name && overlay_names.include?(group_name))

    names << pod_name
    names << pod_name.split("/").first if pod_name.include?("/")
  end
end

puts names.uniq
RUBY
}

cleanup_overlay_pods_dir() {
  [ -d "Pods" ] || return 0

  removed=""
  overlay_pod_names | while IFS= read -r pod_name; do
    [ -n "$pod_name" ] || continue
    pod_dir="Pods/$pod_name"
    [ -d "$pod_dir" ] || continue
    rm -rf "$pod_dir"
    printf "%s\n" "$pod_name"
  done | {
    while IFS= read -r removed_name; do
      removed="${removed}${removed_name} "
    done
    removed="$(printf "%s" "$removed" | sed 's/[[:space:]]*$//')"
    [ -z "$removed" ] || echo "【podx install】已清理 Pods 旧本地组件: $removed"
  }
}

sync_graph_after_pod_install() {
  [ "${COCOAPODS_PODX_SKIP_GRAPH_SYNC:-0}" = "1" ] && return 0

  graph_script=""
  if [ -f ".claude/mcps/update-codegraph.sh" ]; then
    graph_script=".claude/mcps/update-codegraph.sh"
  elif [ -f ".claude/mcp/update-codegraph.sh" ]; then
    graph_script=".claude/mcp/update-codegraph.sh"
  fi

  [ -n "$graph_script" ] || return 0

  (
    COCOAPODS_PODX_NO_PROGRESS=1 /bin/sh "$graph_script" >/dev/null 2>&1
  ) >/dev/null 2>&1 &
}

run_pod_update_for_remote_updates() {
  updates_file="$1"
  shift
  [ -f "$updates_file" ] || return 0

  pod_names="$(awk 'NF && !seen[$0]++ { printf "%s ", $0 }' "$updates_file" 2>/dev/null)"
  pod_names="$(printf "%s" "$pod_names" | sed 's/[[:space:]]*$//')"
  [ -n "$pod_names" ] || return 0

  update_log_file="$(mktemp "${TMPDIR:-/tmp}/podx-update-remote.XXXXXX")"
  echo "【podx install】远端依赖有更新，自动执行 pod update: $pod_names"
  # shellcheck disable=SC2086
  run_capture_with_wait_progress "podx update" "$update_log_file" pod update $pod_names --repo-update
  update_status=$?
  if [ "$update_status" -eq 0 ]; then
    print_pod_install_success_log "$update_log_file"
    rm -f "$update_log_file"
    return 0
  fi

  cat "$update_log_file"
  rm -f "$update_log_file"
  return "$update_status"
}

run_pod_install_with_auto_fix() {
  log_file="$(mktemp "${TMPDIR:-/tmp}/podx-install.XXXXXX")"
  remote_updates_file="$(mktemp "${TMPDIR:-/tmp}/podx-remote-updates.XXXXXX")"
  pbxproj_snapshot_dir="$(snapshot_pbxproj_files)"
  export COCOAPODS_PODX_REMOTE_UPDATES_FILE="$remote_updates_file"
  if args_include_repo_update "$@"; then
    export COCOAPODS_PODX_REPO_UPDATE=1
  else
    unset COCOAPODS_PODX_REPO_UPDATE
  fi
  cleanup_overlay_pods_dir
  run_raw_pod_install_capture "$log_file" "$@"
  status=$?
  if [ "$status" -eq 0 ]; then
    print_pod_install_success_log "$log_file"
    if args_include_repo_update "$@"; then
      run_pod_update_for_remote_updates "$remote_updates_file" "$@"
      status=$?
      if [ "$status" -ne 0 ]; then
        rm -f "$log_file" "$remote_updates_file"
        rm -rf "$pbxproj_snapshot_dir"
        return "$status"
      fi
    fi
    restore_noop_pbxproj_changes "$pbxproj_snapshot_dir"
    sync_graph_after_pod_install
    echo "【podx install】完成"
    rm -f "$log_file" "$remote_updates_file"
    rm -rf "$pbxproj_snapshot_dir"
    return 0
  fi

  if grep -q "Verification checksum was incorrect" "$log_file" 2>/dev/null; then
    pod_name="$(extract_pod_install_error_name "$log_file")"
    if args_include_repo_update "$@"; then
      echo "[podx install] 检测到 ${pod_name:-Pod} 校验和不一致；当前已使用 --repo-update，建议执行：podx cache clean ${pod_name:-NAME} 后重试。"
      rm -f "$log_file" "$remote_updates_file"
      rm -rf "$pbxproj_snapshot_dir"
      return "$status"
    fi

    echo "[podx install] 检测到 ${pod_name:-Pod} 校验和不一致，自动重试：podx install --repo-update"
    retry_log_file="$(mktemp "${TMPDIR:-/tmp}/podx-install-retry.XXXXXX")"
    export COCOAPODS_PODX_REPO_UPDATE=1
    run_raw_pod_install_capture "$retry_log_file" --repo-update "$@"
    retry_status=$?
    if [ "$retry_status" -eq 0 ]; then
      print_pod_install_success_log "$retry_log_file"
      run_pod_update_for_remote_updates "$remote_updates_file" "$@"
      retry_status=$?
      if [ "$retry_status" -ne 0 ]; then
        rm -f "$log_file" "$retry_log_file" "$remote_updates_file"
        rm -rf "$pbxproj_snapshot_dir"
        return "$retry_status"
      fi
      restore_noop_pbxproj_changes "$pbxproj_snapshot_dir"
      sync_graph_after_pod_install
      echo "【podx install】完成"
      rm -f "$log_file" "$retry_log_file" "$remote_updates_file"
      rm -rf "$pbxproj_snapshot_dir"
      return 0
    fi

    cat "$retry_log_file"
    rm -f "$log_file" "$retry_log_file" "$remote_updates_file"
    rm -rf "$pbxproj_snapshot_dir"
    return "$retry_status"
  fi

  cat "$log_file"
  rm -f "$log_file" "$remote_updates_file"
  rm -rf "$pbxproj_snapshot_dir"
  return "$status"
}

