case "$1" in
  ""|help|--help|-h)
    show_help
    ;;
  version|--version|-v)
    detect_podx_lib_and_gem_env
    ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts "cocoapods-podx #{spec ? spec.version : "unknown"}"'
    ;;
  upgrade)
    exec_upgrade_from_temp_shim "$(current_podx_version)" "$2"
    exit $?
    ;;
  __upgrade)
    upgrade_cocoapods_podx "$2" "$3"
    status=$?
    if [ -n "${COCOAPODS_PODX_SELF_UPGRADE_DIR:-}" ]; then
      rm -rf "$COCOAPODS_PODX_SELF_UPGRADE_DIR"
    fi
    exit $status
    ;;
  workon|dev)
    shift
    run_pod_overlay "$@"
    ;;
  check|health)
    shift
    run_pod_overlay --doctor "$@"
    ;;
  graph)
    shift
    run_pod_overlay --ai update "$@"
    ;;
  ship)
    shift
    if [ "$1" = "dry-run" ]; then
      shift
      run_pod_overlay --dry-run --publish "$@"
      exit $?
    fi
    run_pod_overlay --publish "$@"
    ;;
  diagnose)
    shift
    run_pod_overlay --jenkins-doctor "$@"
    ;;
  repair|heal)
    shift
    jenkins_fix_option="--jenkins""-fix"
    run_pod_overlay "$jenkins_fix_option" "$@"
    ;;
  tools)
    shift
    show_modern_cli_tools
    ;;
  publish)
    if ! pod_available; then
      run_publish_only "$@"
    fi
    shift
    case "$1" in
      history)
        shift
        run_pod_overlay --jenkins-history "$@"
        ;;
      log)
        shift
        run_pod_overlay --jenkins-log "$@"
        ;;
      doctor)
        shift
        run_pod_overlay --jenkins-doctor "$@"
        ;;
      fix)
        shift
        jenkins_fix_option="--jenkins""-fix"
        run_pod_overlay "$jenkins_fix_option" "$@"
        ;;
      *)
        run_pod_overlay --publish "$@"
        ;;
    esac
    ;;
  dry-run)
    shift
    if [ "$1" = "publish" ]; then
      shift
      run_pod_overlay --dry-run --publish "$@"
      exit $?
    fi
    if [ "$1" = "hooks" ]; then
      shift
      run_pod_overlay --dry-run --hooks "$@"
      exit $?
    fi
    if [ "$1" = "skill" ]; then
      shift
      run_pod_overlay --dry-run --skill "$@"
      exit $?
    fi
    run_pod_overlay --dry-run "$@"
    ;;
  install)
    shift
    exec pod install "$@"
    ;;
  repo)
    shift
    if [ "$1" = "update" ]; then
      shift
      exec pod repo update "$@"
    fi
    run_pod_overlay repo "$@"
    ;;
  update)
    shift
    run_pod_overlay --update "$@"
    ;;
  clean)
    shift
    run_pod_overlay --clean "$@"
    ;;
  list)
    shift
    run_pod_overlay --list "$@"
    ;;
  deps|dependencies)
    shift
    run_pod_overlay --deps "$@"
    ;;
  rules)
    shift
    run_pod_overlay --rules "$@"
    ;;
  pipeline)
    shift
    run_pod_overlay --pipeline "$@"
    ;;
  skill)
    shift
    run_pod_overlay --skill "$@"
    ;;
  init)
    shift
    upgrade_cocoapods_podx "$(current_podx_version)" "$COCOAPODS_PODX_INIT_VERSION" || exit $?
    if [ "${COCOAPODS_PODX_UPGRADED:-0}" = "1" ]; then
      exec "$0" init "$@"
    fi
    run_pod_overlay --init "$@"
    ;;
  sync)
    shift
    upgrade_cocoapods_podx "$(current_podx_version)" "$COCOAPODS_PODX_SYNC_VERSION" || exit $?
    if [ "${COCOAPODS_PODX_UPGRADED:-0}" = "1" ]; then
      exec "$0" sync "$@"
    fi
    run_pod_overlay --sync "$@"
    ;;
  open)
    shift
    run_pod_overlay --open "$@"
    ;;
  doctor)
    shift
    run_pod_overlay --doctor "$@"
    ;;
  ai)
    shift
    run_pod_overlay --ai "$@"
    ;;
  hooks)
    shift
    run_pod_overlay --hooks "$@"
    ;;
  main)
    shift
    run_pod_overlay --main "$@"
    ;;
  disable)
    shift
    run_pod_overlay --disable "$@"
    ;;
  *)
    run_pod_overlay "$@"
    ;;
esac
