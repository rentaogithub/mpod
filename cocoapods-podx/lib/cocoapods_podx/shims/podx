print_tool_status() {
  purpose="$1"
  command_name="$2"
  package_name="$3"
  if command -v "$command_name" >/dev/null 2>&1; then
    status="installed"
  else
    status="missing: brew install $package_name"
  fi
  printf '  %-24s %-12s %s\n' "$purpose" "$command_name" "$status"
}

