#!/bin/sh

detect_cocoapods_gem_home() {
  pod_path="$(command -v pod 2>/dev/null)"
  if [ -n "$pod_path" ] && [ -f "$pod_path" ]; then
    parsed="$(sed -n 's/^GEM_HOME="\([^"]*\)".*/\1/p' "$pod_path" 2>/dev/null | head -n 1)"
    if [ -n "$parsed" ]; then
      echo "$parsed"
      return 0
    fi
  fi

  ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods").max_by(&:version); puts spec ? File.expand_path("..", spec.full_gem_path) : ""' 2>/dev/null
}

detect_cocoapods_ruby() {
  command -v ruby
}

detect_podx_lib_path() {
  if [ -n "$COCOAPODS_PODX_LOCAL_LIB" ] && [ -d "$COCOAPODS_PODX_LOCAL_LIB" ]; then
    echo "$COCOAPODS_PODX_LOCAL_LIB"
    return 0
  fi

  if [ -n "$gem_home" ]; then
    GEM_HOME="$gem_home" GEM_PATH="$gem_home" ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts spec ? File.join(spec.full_gem_path, "lib") : ""' 2>/dev/null
  else
    ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts spec ? File.join(spec.full_gem_path, "lib") : ""' 2>/dev/null
  fi
}

pod_available() {
  command -v pod >/dev/null 2>&1 && pod --version >/dev/null 2>&1
}

latest_podx_version_from_nexus() {
  if [ -n "$COCOAPODS_PODX_LATEST_VERSION" ]; then
    echo "$COCOAPODS_PODX_LATEST_VERSION"
    return 0
  fi

  NEXUS_SEARCH_API="${COCOAPODS_PODX_NEXUS_SEARCH_API:-${COCOAPODS_OVERLAY_NEXUS_SEARCH_API:-http://172.31.4.4:9091/service/rest/beta/search/assets?repository=nn_ios}}" \
  NEXUS_USER="${COCOAPODS_PODX_NEXUS_USER:-${COCOAPODS_OVERLAY_NEXUS_USER:-admin}}" \
  NEXUS_PASSWORD="${COCOAPODS_PODX_NEXUS_PASSWORD:-${COCOAPODS_OVERLAY_NEXUS_PASSWORD:-admin123}}" \
  ruby -e '
require "json"
require "net/http"
require "uri"

api = ENV.fetch("NEXUS_SEARCH_API")
user = ENV["NEXUS_USER"]
password = ENV["NEXUS_PASSWORD"]
versions = []
token = nil

loop do
  uri = URI(api)
  params = URI.decode_www_form(uri.query || "")
  params << ["continuationToken", token] if token && !token.empty?
  uri.query = URI.encode_www_form(params)
  request = Net::HTTP::Get.new(uri)
  request.basic_auth(user, password) if user && !user.empty?
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https") { |http| http.request(request) }
  abort("Nexus 查询失败：HTTP #{response.code}") unless response.is_a?(Net::HTTPSuccess)
  body = JSON.parse(response.body)
  Array(body["items"]).each do |item|
    path = item["path"].to_s
    next unless path.start_with?("rubygems/cocoapods-podx/")
    match = path.match(%r{cocoapods-podx-([0-9]+(?:\.[0-9]+)*)\.gem\z})
    versions << match[1] if match
  end
  token = body["continuationToken"]
  break if token.nil? || token.empty?
end

abort("Nexus 中未找到 cocoapods-podx gem。") if versions.empty?
puts versions.max_by { |version| version.split(".").map(&:to_i) }
'
}

upgrade_cocoapods_podx() {
  current_version="$1"
  target_version="$2"
  COCOAPODS_PODX_UPGRADED=0
  gem_home="$(detect_cocoapods_gem_home)"
  if [ -z "$gem_home" ]; then
    gem_home="$(ruby -e 'require "rubygems"; puts Gem.user_dir')"
  fi

  if [ -z "$target_version" ]; then
    target_version="$(latest_podx_version_from_nexus)"
  fi

  case "$target_version" in
    ""|*[!0-9.]*|.*|*..*|*.)
      echo "cocoapods-podx [upgrade] 版本号不合法：$target_version" >&2
      return 1
      ;;
  esac

  if [ -n "$target_version" ] && [ "$target_version" = "$current_version" ]; then
    echo "cocoapods-podx $current_version 已是最新版本，无需更新"
    return 0
  fi

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/cocoapods-podx-upgrade.XXXXXX")"
  gem_file="$tmp_dir/cocoapods-podx-$target_version.gem"
  gem_url="${COCOAPODS_PODX_GEM_SOURCE:-${COCOAPODS_OVERLAY_GEM_SOURCE:-http://172.31.4.4:9091/repository/nn_ios/rubygems/cocoapods-podx/}}"
  gem_url="${gem_url%/}/cocoapods-podx-$target_version.gem"
  nexus_user="${COCOAPODS_PODX_NEXUS_USER:-${COCOAPODS_OVERLAY_NEXUS_USER:-admin}}"
  nexus_password="${COCOAPODS_PODX_NEXUS_PASSWORD:-${COCOAPODS_OVERLAY_NEXUS_PASSWORD:-admin123}}"

  echo "cocoapods-podx [upgrade] $current_version -> $target_version"
  if [ -n "$nexus_user" ]; then
    curl -fL -u "$nexus_user:$nexus_password" -o "$gem_file" "$gem_url" || {
      rm -rf "$tmp_dir"
      return 1
    }
  else
    curl -fL -o "$gem_file" "$gem_url" || {
      rm -rf "$tmp_dir"
      return 1
    }
  fi

  GEM_HOME="$gem_home" \
  GEM_PATH="$gem_home" \
  gem install --local --ignore-dependencies --force --no-document "$gem_file"

  installed_dir="$(GEM_HOME="$gem_home" GEM_PATH="$gem_home" ruby -e 'spec = Gem::Specification.find_by_name("cocoapods-podx"); puts spec.full_gem_path')"
  command_dir="${COCOAPODS_PODX_COMMAND_DIR:-$(dirname "$0")}"
  if [ -w "$command_dir" ]; then
    install_upgrade_shim "$installed_dir/bin/podx" "$command_dir/podx"
    install_upgrade_shim "$installed_dir/bin/mgit" "$command_dir/mgit"
  else
    echo "Warning: 无法刷新命令 shim：$command_dir 不可写" >&2
  fi

  rm -rf "$tmp_dir"
  COCOAPODS_PODX_UPGRADED=1
  echo "cocoapods-podx [upgraded] $target_version"
}

exec_upgrade_from_temp_shim() {
  current_version="$1"
  target_version="$2"
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/cocoapods-podx-self-upgrade.XXXXXX")"
  tmp_shim="$tmp_dir/podx"
  cp "$0" "$tmp_shim"
  chmod +x "$tmp_shim"
  COCOAPODS_PODX_COMMAND_DIR="$(dirname "$0")" \
  COCOAPODS_PODX_SELF_UPGRADE_DIR="$tmp_dir" \
  exec "$tmp_shim" __upgrade "$current_version" "$target_version"
}

install_upgrade_shim() {
  source_path="$1"
  target_path="$2"
  tmp_path="${target_path}.tmp.$$"
  running_path="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0")"
  target_real_path="$(cd "$(dirname "$target_path")" 2>/dev/null && pwd -P)/$(basename "$target_path")"
  cp "$source_path" "$tmp_path"
  chmod +x "$tmp_path"
  if [ "$target_real_path" = "$running_path" ]; then
    echo "Warning: 跳过正在执行的 shim 刷新：$target_path" >&2
    rm -f "$tmp_path"
    return 0
  fi
  mv -f "$tmp_path" "$target_path"
}

current_podx_version() {
  gem_home="$(detect_cocoapods_gem_home)"
  if [ -n "$gem_home" ]; then
    GEM_HOME="$gem_home" GEM_PATH="$gem_home" ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts spec ? spec.version : ""' 2>/dev/null
  else
    ruby -e 'spec = Gem::Specification.find_all_by_name("cocoapods-podx").max_by(&:version); puts spec ? spec.version : ""' 2>/dev/null
  fi
}

detect_podx_lib_and_gem_env() {
  gem_home="$(detect_cocoapods_gem_home)"
  podx_lib="$(detect_podx_lib_path)"
  if [ -n "$podx_lib" ]; then
    export RUBYLIB="$podx_lib${RUBYLIB:+:$RUBYLIB}"
  fi
  if [ -n "$gem_home" ]; then
    export GEM_HOME="$gem_home"
  fi
}

run_publish_only() {
  detect_podx_lib_and_gem_env
  exec ruby -rcocoapods_podx/publish_only -e 'CocoapodsPodx::PublishOnly.run(ARGV)' -- "$@"
}

run_pod_overlay() {
  detect_podx_lib_and_gem_env
  COCOAPODS_PODX_INTERNAL=1 exec pod podx "$@"
}

